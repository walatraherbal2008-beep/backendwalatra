    "name": "Backend Walatra - Everpro Location API",
    "description": "Collection untuk menguji proxy master lokasi Everpro melalui API Backend Walatra. Credential Everpro tetap disimpan di backend dan tidak diperlukan di Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "province_id",
      "value": "32"
    },
    {
      "key": "province_name",
      "value": "Jawa Barat"
    },
    {
      "key": "city_id",
      "value": "3273"
    },
