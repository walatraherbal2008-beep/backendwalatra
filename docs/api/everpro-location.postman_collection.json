  "item": [
    {
      "name": "1. Get Provinces",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/shipping/locations/provinces?q={{province_name}}",
          "host": ["{{base_url}}"],
          "path": ["shipping", "locations", "provinces"],
          "query": [
            {
              "key": "q",
              "value": "{{province_name}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Response sukses', function () { pm.expect(json.success).to.eql(true); });",
              "const location = json.data && json.data.locations && json.data.locations[0];",
              "if (location && (location.id || location.province_id)) { pm.collectionVariables.set('province_id', location.id || location.province_id); }"
            ]
          }
        }
      ]
    },
