              "raw": "{{base_url}}/catalog/bundles/{{bundle_slug}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "catalog",
                "bundles",
                "{{bundle_slug}}"
              ]
            },
            "description": "Jalankan Daftar bundle dahulu atau isi bundle_slug. Harga bundle adalah harga tetapnya, bukan jumlah harga retail komponen. items[].quantity adalah jumlah komponen per bundle."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respons JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"Status success sesuai\", function () { pm.expect(body.success).to.eql(true); });"
                ]
              }
            }
          ],
