    {
      "name": "05 - Contoh validasi (HTTP 422 diharapkan)",
      "item": [
        {
          "name": "Harga maksimum kurang dari minimum",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/catalog?min_price=50000&max_price=10000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "catalog"
              ],
              "query": [
                {
                  "key": "min_price",
                  "value": "50000",
                  "description": "Harga minimum"
                },
                {
                  "key": "max_price",
                  "value": "10000",
                  "description": "Sengaja lebih kecil dari minimum"
                }
              ]
            },
            "description": "Contoh error VALIDATION_ERROR; HTTP 422 adalah hasil yang diharapkan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });",
                  "pm.test(\"Respons JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"Status success sesuai\", function () { pm.expect(body.success).to.eql(false); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Pagination melebihi batas",
