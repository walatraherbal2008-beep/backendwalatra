              "path": [
                "shipping",
                "locations",
                "cities"
              ],
              "query": [
                {
                  "key": "province_id",
                  "value": "{{province_id_query}}",
                  "description": "ID provinsi; otomatis di-encode dari province_id."
                }
              ]
            },
            "description": "Publik. Jalankan Daftar provinsi terlebih dahulu atau isi province_id. Menyimpan hasil kota pertama.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const value = pm.collectionVariables.get(\"province_id\");",
                  "if (!value) throw new Error(\"Isi province_id atau jalankan daftar wilayah induk terlebih dahulu.\");",
                  "pm.variables.set(\"province_id_query\", encodeURIComponent(value));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respons JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"Request berhasil\", function () { pm.expect(body.success).to.eql(true); });",
                  "if (pm.response.code === 200 && Array.isArray(body.data?.locations)) {",
                  "  const first = body.data.locations[0];",
                  "  pm.collectionVariables.set(\"city_id\", \"\");",
                  "  pm.collectionVariables.set(\"city_name\", \"\");",
                  "  pm.collectionVariables.set(\"district_id\", \"\");",
                  "  pm.collectionVariables.set(\"district_name\", \"\");",
                  "  pm.collectionVariables.set(\"sub_district_id\", \"\");",
                  "  pm.collectionVariables.set(\"sub_district_name\", \"\");",
                  "  if (first?.city_id !== undefined && first.city_id !== null) pm.collectionVariables.set(\"city_id\", String(first.city_id));",
                  "  if (first?.city_name !== undefined && first.city_name !== null) pm.collectionVariables.set(\"city_name\", String(first.city_name));",
                  "}"
                ]
              }
            }
