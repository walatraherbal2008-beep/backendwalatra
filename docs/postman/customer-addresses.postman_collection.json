    {
      "name": "02 - Manajemen alamat",
      "item": [
        {
          "name": "Daftar alamat",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/addresses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "addresses"
              ]
            },
            "description": "Memerlukan token customer. Respons data berupa array tanpa pagination. Request ini tidak otomatis memilih address_id dari alamat yang sudah ada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respons JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"Request berhasil\", function () { pm.expect(body.success).to.eql(true); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Tambah alamat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/addresses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "addresses"
              ]
            },
            "description": "Memerlukan token customer. Jalankan daftar wilayah secara berurutan atau isi semua variabel wilayah. ID alamat baru disimpan sebagai address_id. Alamat pertama otomatis menjadi alamat utama.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"{{address_label}}\",\n  \"name\": \"{{recipient_name}}\",\n  \"phone\": \"{{recipient_phone}}\",\n  \"province\": \"{{province_name}}\",\n  \"province_id\": \"{{province_id}}\",\n  \"province_name\": \"{{province_name}}\",\n  \"city\": \"{{city_name}}\",\n  \"city_id\": \"{{city_id}}\",\n  \"city_name\": \"{{city_name}}\",\n  \"district\": \"{{district_name}}\",\n  \"district_id\": \"{{district_id}}\",\n  \"district_name\": \"{{district_name}}\",\n  \"sub_district_id\": \"{{sub_district_id}}\",\n  \"sub_district_name\": \"{{sub_district_name}}\",\n  \"postal_code\": \"{{postal_code}}\",\n  \"address\": \"{{street_address}}\",\n  \"address_note\": \"{{address_note}}\",\n  \"is_default\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const required = [\"province_id\", \"province_name\", \"city_id\", \"city_name\", \"district_id\", \"district_name\", \"sub_district_id\", \"sub_district_name\", \"postal_code\"];",
                  "const missing = required.filter((key) => !pm.collectionVariables.get(key));",
                  "if (missing.length) throw new Error(\"Lengkapi variabel lokasi: \" + missing.join(\", \"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Respons JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"Request berhasil\", function () { pm.expect(body.success).to.eql(true); });",
                  "if (pm.response.code === 201 && body.data?.id) pm.collectionVariables.set(\"address_id\", String(body.data.id));"
                ]
              }
            }
          ],
          "response": []
        },
