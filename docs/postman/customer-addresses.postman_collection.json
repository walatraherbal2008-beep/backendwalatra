{
  "info": {
    "name": "Walatra - Alamat Customer dan Lokasi Everpro",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Koleksi sesuai docs/api/customer-addresses.md. Isi collection variables base_url dan customer_token. Jalankan folder 01 berurutan untuk mengisi ID wilayah dari hasil pertama, lalu gunakan request alamat pada folder 02. Pilihan wilayah dapat diubah pada Variables. ID mentah disimpan sebagai string dan di-encode pada query. Endpoint Everpro bersifat publik; token Everpro ditangani backend. Request Hapus alamat menghapus ID pada address_id. Mengubah alamat utama memengaruhi penanda alamat lain. Tidak ada request checkout atau pembuatan order dalam koleksi ini. Pengaturan URL: base_url wajib mencakup /api/v1 tanpa slash terakhir, misalnya http://127.0.0.1:8000/api/v1. Jika Environment aktif memiliki variable dengan nama sama, nilainya menimpa Collection, termasuk ID/token yang diisi otomatis; samakan nilainya atau hapus duplikat Environment. Panduan: docs/api/postman-setup.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customer_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string",
      "description": "Base URL backend tanpa slash terakhir."
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string",
      "description": "Token login customer dengan ability customer-api; bukan token Everpro."
    },
    {
      "key": "address_id",
      "value": "",
      "type": "string",
      "description": "ID alamat dari respons Tambah alamat; dapat diisi manual."
    },
    {
      "key": "province_search",
      "value": "Jawa Barat",
      "type": "string",
      "description": "Pencarian nama provinsi."
    },
    {
      "key": "province_id",
      "value": "",
      "type": "string",
      "description": "Diisi dari Daftar provinsi, disimpan tanpa URL encoding."
    },
    {
      "key": "province_name",
      "value": "",
      "type": "string",
      "description": "Diisi dari Daftar provinsi."
    },
    {
      "key": "city_id",
      "value": "",
      "type": "string",
      "description": "Diisi dari Daftar kota/kabupaten."
    },
    {
      "key": "city_name",
      "value": "",
      "type": "string",
      "description": "Diisi dari Daftar kota/kabupaten."
    },
    {
      "key": "district_id",
      "value": "",
      "type": "string",
      "description": "Diisi dari Daftar kecamatan."
    },
    {
      "key": "district_name",
      "value": "",
      "type": "string",
      "description": "Diisi dari Daftar kecamatan."
    },
    {
      "key": "sub_district_id",
      "value": "",
      "type": "string",
      "description": "Diisi dari Daftar kelurahan/desa."
    },
    {
      "key": "sub_district_name",
      "value": "",
      "type": "string",
      "description": "Diisi dari Daftar kelurahan/desa."
    },
    {
      "key": "postal_code",
      "value": "40135",
      "type": "string",
      "description": "Diisi dari kelurahan terpilih; juga dipakai untuk resolve."
    },
    {
      "key": "address_label",
      "value": "Rumah",
      "type": "string",
      "description": "Label alamat."
    },
    {
      "key": "recipient_name",
      "value": "Pembeli Walatra",
      "type": "string",
      "description": "Nama penerima."
    },
    {
      "key": "recipient_phone",
      "value": "081234567890",
      "type": "string",
      "description": "Nomor penerima, dikirim sebagai string."
    },
    {
      "key": "street_address",
      "value": "Jalan Contoh Nomor 1",
      "type": "string",
      "description": "Alamat jalan penerima."
    },
    {
      "key": "address_note",
      "value": "Pagar hitam",
      "type": "string",
      "description": "Catatan alamat."
    }
  ],
  "item": [
    {
      "name": "01 - Lokasi Everpro",
      "item": [
        {
          "name": "Daftar provinsi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shipping/locations/provinces?q={{province_search}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipping",
                "locations",
                "provinces"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{province_search}}",
                  "description": "Pencarian nama provinsi, maksimal 100 karakter."
                }
              ]
            },
            "description": "Publik. Menyimpan ID dan nama hasil pertama; mengosongkan pilihan wilayah turunan. Nonaktifkan q untuk daftar tanpa filter nama.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respons JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"Request berhasil\", function () { pm.expect(body.success).to.eql(true); });",
                  "if (pm.response.code === 200 && Array.isArray(body.data?.locations)) {",
                  "  const first = body.data.locations[0];",
                  "  pm.collectionVariables.set(\"province_id\", \"\");",
                  "  pm.collectionVariables.set(\"province_name\", \"\");",
                  "  pm.collectionVariables.set(\"city_id\", \"\");",
                  "  pm.collectionVariables.set(\"city_name\", \"\");",
                  "  pm.collectionVariables.set(\"district_id\", \"\");",
                  "  pm.collectionVariables.set(\"district_name\", \"\");",
                  "  pm.collectionVariables.set(\"sub_district_id\", \"\");",
                  "  pm.collectionVariables.set(\"sub_district_name\", \"\");",
                  "  if (first?.province_id !== undefined && first.province_id !== null) pm.collectionVariables.set(\"province_id\", String(first.province_id));",
                  "  if (first?.province_name !== undefined && first.province_name !== null) pm.collectionVariables.set(\"province_name\", String(first.province_name));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Daftar kota/kabupaten",
