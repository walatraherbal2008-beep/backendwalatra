APP_NAME="Walatra Herbal Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
COMPANY_WHATSAPP_URL=

SUPERADMIN_NAME="Walatra Super Admin"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FORCE_PASSWORD=false

SANCTUM_EXPIRATION=43200
OTP_EXPOSE_CODE=false
FRONTEND_BRIDGE_SECRET=
OTP_REQUEST_PHONE_LIMIT=10
OTP_REQUEST_IP_LIMIT=20
OTP_VERIFY_IP_LIMIT=30
EXTERNAL_LOG_RETENTION_DAYS=30
API_REQUEST_AUDIT_ENABLED=true
API_REQUEST_AUDIT_RETENTION_DAYS=90
API_REQUEST_AUDIT_PAYLOAD_MAX_BYTES=32768
PAYMENT_WEBHOOK_MAX_BYTES=16384
MAXCHAT_ENABLED=false
MAXCHAT_BASE_URL=https://core.maxchat.id/walatra-herbal
MAXCHAT_API_TOKEN=
MAXCHAT_TIMEOUT=30
MAXCHAT_CONNECT_TIMEOUT=5

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_TIMEZONE=Asia/Jakarta
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=360

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOG_WHATSAPP_LEVEL=debug

# Payment gateway
ORDER_SIMULATION_ENABLED=false
ORDER_SIMULATION_SHIPPING_FEE=0
ORDER_PROCESSING_MODE=integrated
CHECKOUT_STOCK_MODE=unlimited
CHECKOUT_WAREHOUSE_CODE=
FREE_SHIPPING_ENABLED=true
MANUAL_ORDER_SHIPPING_FEE=0
MANUAL_PAYMENT_INSTRUCTIONS="Hubungi admin untuk petunjuk pembayaran. Pembayaran akan diverifikasi secara manual."
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# For production, update the base URL and QR host allowlist together.
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_QR_ALLOWED_HOSTS=merchants-app.sbx.midtrans.com
MIDTRANS_TIMEOUT=10
MIDTRANS_PAYMENT_METHODS=bca_va,bni_va,bri_va,mandiri_bill,permata_va,qris
MIDTRANS_QRIS_ACQUIRER=gopay
MIDTRANS_VA_EXPIRY_MINUTES=1440
MIDTRANS_QRIS_EXPIRY_MINUTES=15
MIDTRANS_ORDER_TTL_HOURS=24

# Warehouse remaining-stock endpoint (multipart/form-data body: code=<warehouse_code>, produk=<product_code>, e.g. QNC)
# Nearest warehouse uses Haversine distance. Stock can stay unlimited until the stock API is reliable.
CHECKOUT_WAREHOUSE_SELECTION=nearest_available
CHECKOUT_WAREHOUSE_SELECTION_TIMEOUT=15
WAREHOUSE_REMAINING_STOCK_ENABLED=false
WAREHOUSE_REMAINING_STOCK_BASE_URL=https://originalwalatraherbal.com
WAREHOUSE_REMAINING_STOCK_PATH=/index.php?procs=gudang.stok.sisa
WAREHOUSE_REMAINING_STOCK_TIMEOUT=3
WAREHOUSE_STOCK_ENABLED=false
WAREHOUSE_STOCK_BASE_URL=
WAREHOUSE_STOCK_TOKEN=
WAREHOUSE_STOCK_TIMEOUT=10
WAREHOUSE_STOCK_CHECK_PATH=/stock/check
WAREHOUSE_STOCK_RESERVE_PATH=/stock/reserve
WAREHOUSE_STOCK_CONFIRM_PATH=/stock/confirm
WAREHOUSE_STOCK_RELEASE_PATH=/stock/release
WAREHOUSE_DIRECTORY_ENABLED=true
WAREHOUSE_DIRECTORY_BASE_URL=https://originalwalatraherbal.com
WAREHOUSE_DIRECTORY_PATH=/index.php?procs=gudang.list
WAREHOUSE_DIRECTORY_DETAIL_PATH=/index.php?procs=gudang.detail
WAREHOUSE_DIRECTORY_TIMEOUT=10

# Shipping rate API
SHIPPING_RATE_ENABLED=false
SHIPPING_RATE_BASE_URL=
SHIPPING_RATE_TOKEN=
SHIPPING_RATE_TIMEOUT=10
SHIPPING_RATE_QUOTE_PATH=/shipping/quote


EVERPRO_ENABLED=false
EVERPRO_BASE_URL=https://client-api-sandbox.everpro.id
EVERPRO_CLIENT_KEY=
EVERPRO_CLIENT_SECRET=
EVERPRO_TIMEOUT=10
EVERPRO_TOKEN_PATH=/auth/v1/token
EVERPRO_PROVINCES_PATH=/location/v1/provinces
EVERPRO_CITIES_PATH=/location/v1/cities
EVERPRO_DISTRICTS_PATH=/location/v1/districts
EVERPRO_SUB_DISTRICTS_PATH=/location/v1/sub-districts
EVERPRO_LOCATION_RESOLVE_PATH=/location/v1/postalcode
