APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

SUPERADMIN_NAME="Walatra Super Admin"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FORCE_PASSWORD=false

SANCTUM_EXPIRATION=43200
OTP_EXPOSE_CODE=false
MAXCHAT_ENABLED=false
MAXCHAT_BASE_URL=https://core.maxchat.id/walatra-herbal
MAXCHAT_API_TOKEN=
MAXCHAT_TIMEOUT=30
MAXCHAT_CONNECT_TIMEOUT=5

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_TIMEZONE=Asia/Jakarta
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOG_WHATSAPP_LEVEL=debug

# Payment gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Warehouse stock API
WAREHOUSE_STOCK_ENABLED=false
WAREHOUSE_STOCK_BASE_URL=
WAREHOUSE_STOCK_TOKEN=
WAREHOUSE_STOCK_TIMEOUT=10
WAREHOUSE_STOCK_CHECK_PATH=/stock/check
WAREHOUSE_STOCK_RESERVE_PATH=/stock/reserve
WAREHOUSE_STOCK_CONFIRM_PATH=/stock/confirm
WAREHOUSE_STOCK_RELEASE_PATH=/stock/release
WAREHOUSE_DIRECTORY_ENABLED=true
WAREHOUSE_DIRECTORY_BASE_URL=https://originalwalatraherbal.com
WAREHOUSE_DIRECTORY_PATH=/index.php?procs=gudang.list
WAREHOUSE_DIRECTORY_TIMEOUT=10

# Shipping rate API
SHIPPING_RATE_ENABLED=false
SHIPPING_RATE_BASE_URL=
SHIPPING_RATE_TOKEN=
SHIPPING_RATE_TIMEOUT=10
SHIPPING_RATE_QUOTE_PATH=/shipping/quote


EVERPRO_ENABLED=false
EVERPRO_BASE_URL=https://client-api-sandbox.everpro.id
EVERPRO_CLIENT_KEY=
EVERPRO_CLIENT_SECRET=
EVERPRO_TIMEOUT=10
