# Gabungkan dengan konfigurasi database, APP_KEY, queue, dan integrasi server Anda.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.id
OTP_EXPOSE_CODE=false
SESSION_SECURE_COOKIE=true
FRONTEND_BRIDGE_SECRET=
OTP_REQUEST_PHONE_LIMIT=10
OTP_REQUEST_IP_LIMIT=20
OTP_VERIFY_IP_LIMIT=30
EXTERNAL_LOG_RETENTION_DAYS=30
PAYMENT_WEBHOOK_MAX_BYTES=16384
LOG_LEVEL=warning
